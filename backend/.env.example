# Conexion al Postgres de docker-compose (puerto 55432 del host, 5432 dentro del contenedor)
DATABASE_URL=postgres://contabilidad:contabilidad@localhost:55432/contabilidad

# Secretos de la API (cambiar en produccion)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Puerto del servidor HTTP
PORT=4000

# Datos del administrador inicial que crea `npm run db:seed`
# El login es por cedula, el correo electronico no se usa.
ADMIN_CEDULA=1000000001
ADMIN_NOMBRE=Administrador
ADMIN_CONTRASENA=Admin12345
