{
  "name": "contabilidad-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:generate": "npm --prefix backend run db:generate",
    "db:studio": "npm --prefix backend run db:studio",
    "dev:api": "npm --prefix backend run dev",
    "dev:app": "npm --prefix frontend run start",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend exec tsc -- --noEmit"
  }
}
